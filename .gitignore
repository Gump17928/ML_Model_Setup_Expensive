# Ignore everything, then allow only what is needed to build the reports.
*
!*/
!.gitignore
!*.tex
!*.sty

# Logo images referenced by intake-style.sty (e.g. shared/logo.png)
!shared/*.png
!shared/*.jpg
!shared/*.pdf

# Separate repos (engineering_doc_templates); never embed them here
/engineering-intake-templates*/
